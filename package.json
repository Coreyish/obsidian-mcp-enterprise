{
  "name": "obsidian-mcp-enterprise",
  "version": "0.1.0",
  "description": "Enterprise-grade MCP server for Obsidian vaults (Node.js + TypeScript)",
  "main": "./dist/index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --enable-source-maps --loader ts-node/esm src/cli.ts",
    "start": "node --enable-source-maps dist/cli.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "model context protocol",
    "enterprise",
    "notes",
    "search"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "obsidian-mcp-enterprise": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "fast-glob": "^3.3.3",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
